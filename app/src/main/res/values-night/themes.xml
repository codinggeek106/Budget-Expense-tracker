<resources>
    <!-- Dark window so there is no white flash before Compose draws in dark mode. -->
    <style name="Theme.SpendTrack" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>

    <style name="Theme.SpendTrack.Dialog" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">92%</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
    </style>
</resources>
